# Camp 404 — example environment variables.
# Copy to .env.local in apps/web (and other apps that need it) and fill in.

# --- Database (Neon Postgres) ---
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Neon Auth (Better Auth) ---
# Get the base URL from Neon Console → your project → Auth → Configuration.
# Generate a cookie secret (32+ chars) with: openssl rand -base64 32

# --- File storage (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=

# --- AI providers ---
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# --- Push (Firebase Admin SDK) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Telegram bot ---
# Bot token from @BotFather. Bot must be made an admin of the camp's
# main group AND announcement channel for createChatInviteLink + post.
TELEGRAM_BOT_TOKEN=
# Random secret passed to setWebhook + checked on every incoming update.
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# --- Cron + crypto ---
# Bearer secret for /api/cron/* endpoints.
CRON_SECRET=
# pgcrypto symmetric key for passport / SA-ID / EFT columns. Rotate annually.
PGCRYPTO_KEY=

# --- Signup gating ---
# Comma-separated list of currently-valid invite codes. Bootstrap fallback
# (unlimited uses, no DB row required); leave empty in production and
# issue DB-backed codes via `camp404 mint-invite` instead. The founder's
# first code is minted via `camp404 bootstrap-founder --email …`.
INVITE_CODES=
# Comma-separated list of email addresses that bypass the invite-code check.
# These are the "god accounts" — Camp Lead etc.
GOD_EMAILS=

# --- In-app feedback (GitHub Issues) ---
# Fine-grained PAT with "Issues: Read and write" on RyRy79261/camp-404.
# Optional / not boot-required — the "shake to report" modal degrades to a
# "not set up yet" message when this is unset.
GITHUB_FEEDBACK_TOKEN=
# Optional; target repo for filed issues. Defaults to RyRy79261/camp-404.
GITHUB_FEEDBACK_REPO=

# --- Sign-in (self-hosted Better Auth, packages/auth) ---
# Signing secret, 32+ characters: `openssl rand -base64 32`. REQUIRED on every
# Vercel deployment: without it sign-in is switched off there (fail closed).
BETTER_AUTH_SECRET=
# The address members visit, e.g. https://www.camp-404.com (reset links and
# the Google return are built from it).
BETTER_AUTH_URL=
# The registrable domain, so one passkey works on the bare domain and www.
AUTH_APEX_DOMAIN=
# Optional: Google sign-in. The button only shows when both are set. Authorised
# redirect URI in Google Cloud: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: set true to make sign-in wait for a verified email (needs Resend).
BETTER_AUTH_REQUIRE_EMAIL_VERIFICATION=
# Test deployments only; leave unset in production.
AUTH_RATE_LIMIT_WINDOW_SECONDS=
AUTH_RATE_LIMIT_MAX=

# --- Camp calendar (Home's "Coming up") ---
# The shared Google Calendar's ID (Calendar settings → "Integrate calendar").
# Share the calendar with the Firebase service account (FIREBASE_CLIENT_EMAIL)
# with "See all event details"; it reads the calendar with that account.
GOOGLE_CALENDAR_ID=

# The camp calendar's own Google service account (reads GOOGLE_CALENDAR_ID).
# Share the calendar with the client email; the key is the PEM from its JSON key file.
GOOGLE_CALENDAR_CLIENT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY=
# E2E only: auth emails are written here instead of sent. Ignored on Vercel and outside E2E_TEST_MODE.
AUTH_EMAIL_CAPTURE_FILE=
