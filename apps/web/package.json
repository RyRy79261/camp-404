{
  "name": "@camp404/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "build:mobile": "MOBILE_BUILD=1 next build",
    "vercel-build": "pnpm --filter @camp404/db db:migrate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:mobile": "playwright test --project=mobile-360",
    "test:e2e:db": "playwright test --config playwright.db.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@better-auth/passkey": "1.6.25",
    "@camp404/ai-prompts": "workspace:*",
    "@camp404/auth": "workspace:*",
    "@camp404/core": "workspace:*",
    "@camp404/db": "workspace:*",
    "@camp404/telegram": "workspace:*",
    "@camp404/types": "workspace:*",
    "@camp404/ui": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "1.26.0",
    "@tiptap/pm": "3.29.0",
    "@tiptap/react": "3.29.0",
    "@tiptap/starter-kit": "3.29.0",
    "@vercel/blob": "^2.4.0",
    "better-auth": "1.6.25",
    "drizzle-orm": "^0.45.2",
    "firebase": "^12.14.0",
    "firebase-admin": "^13.10.0",
    "groq-sdk": "^1.2.0",
    "lucide-react": "^1.16.0",
    "mcp-handler": "^1.1.0",
    "next": "^16.3.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@camp404/eslint-config": "workspace:*",
    "@camp404/typescript-config": "workspace:*",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.0",
    "eslint-config-next": "^16.2.6",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
